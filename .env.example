# ─────────────────────────────────────────
# CarbonTrack — Variables d'environnement
# Copiez ce fichier en .env.local (dev) ou configurez dans votre hébergeur (production)
# ─────────────────────────────────────────

# Base de données PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=CHANGE_ME_strong_password
PGDATABASE=carbontrack

# JWT — Générez avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_32_char_random_hex_string

# Environnement (development | production)
NODE_ENV=development
